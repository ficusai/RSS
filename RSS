#!/usr/bin/env bash
# What: Shell script shortcut to launch the RSS application dynamically on any Linux system.
# Options: Can be run directly without parameters (opens GUI) or with '--headless' / '--scrape'.
# Defaults: If no arguments are passed, opens graphical desktop app.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
python3 "$SCRIPT_DIR/main.py" "$@"
